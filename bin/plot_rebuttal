#!/usr/bin/env python3

import pandas as pd
import matplotlib.pyplot as plt
import sys
import os

from IPython import embed

df = pd.read_csv(sys.argv[1])
df["abortrate"] = 100 * (df["aborts"] / (df["aborts"] + df["commits"]))

base_path = os.path.dirname(__file__) + "/../build/artifacts/ycsb/figures"

plt.rcParams["font.size"] = 18
plt.rcParams["figure.dpi"] = 150
plt.rcParams["figure.figsize"] = [6, 7]
plt.tight_layout()

def label_gen(p, i):
    if p == "Silo" and i == "OpenBwTree":
        return "Baseline"
    if p == "SiloNWR" and i == "OpenBwTree":
        return "+NWR"
    if p == "SiloNWR" and i == "PLI":
        return "+NWR,PLI"


def style(i):
    return ['+-', 'o-', '.--', 's:'][i]

# x-axis threads, YCSB-D, E (1000ms)
for workload in ["d", "e"]:
    for contention in df.contention.unique():
        if contention not in [0.3, 0.99]:
            continue
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and epoch==1000 and contention=={contention} and index=="{index}" and protocol=="{protocol}"')

                mean = table.groupby(
                    ["index", "protocol", "threads"], as_index=False).mean()
                mean.plot(x='threads', y='tps',
                          xlim=[0, df.threads.max()],
                          label=label_gen(protocol, index),
                          ax=ax,
                          style=style(cnt),
                          ylabel="Thoughput (req/sec)",
                          xlabel="Number of Threads")
                cnt = cnt + 1
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_tps.pdf")
        plt.clf()
        plt.close('all')


# x-axis threads, YCSB-D, E, aborts 
for workload in ["d", "e"]:
    for contention in df.contention.unique():
        if contention not in [0.3, 0.99]:
            continue
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and epoch==1000 and contention=={contention} and index=="{index}" and protocol=="{protocol}"')

                mean = table.groupby(
                    ["index", "protocol", "threads"], as_index=False).mean()
                mean.plot(x='threads', y='abortrate',
                          xlim=[0, df.threads.max()],
                          label=label_gen(protocol, index),
                          ax=ax,
                          style=style(cnt),
                          ylabel="Abort rate (%)",
                          xlabel="Number of Threads")
                cnt = cnt + 1
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_aborts.pdf")
        plt.clf()
        plt.close('all')


# x-axis threads, YCSB-A, fixed recordsize (2048 bytes)
for workload in ["a"]:
    for contention in df.contention.unique():
        if contention not in [0.3, 0.99]:
            continue
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and epoch==1000 and contention=={contention} and index=="{index}" and recordsize==2048 and protocol=="{protocol}"')

                mean = table.groupby(
                    ["index", "protocol", "threads"], as_index=False).mean()
                mean.plot(x='threads', y='tps',
                          xlim=[0, df.threads.max()],
                          label=label_gen(protocol, index),
                          ax=ax,
                          style=style(cnt),
                          ylabel="Thoughput (req/sec)",
                          xlabel="Number of Threads")
                cnt = cnt + 1
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_fixedrecordsize_tps.pdf")
        plt.clf()
        plt.close('all')

# x-axis RecordSize, YCSB-A
for workload in ["a"]:
    plt.figure()
    ax = df.plot()
    ax.cla()
    cnt = 0
    for index in df["index"].unique():
        for protocol in df.protocol.unique():
            if protocol == "Silo" and index == "PLI":
                continue
            table = df.query(
                f'workloads=="{workload}" and epoch==1000 and threads=={df.threads.max()} and index=="{index}" and protocol=="{protocol}"')
            line = table.groupby(
                ["index", "protocol", "recordsize"], as_index=False).mean()
            line.plot(x='recordsize', y='tps',
                      label=label_gen(protocol, index),
                      ax=ax,
                      style=style(cnt),
                      ylabel="Thoughput (req/sec)",
                      xlabel="# of record size (bytes)")
            cnt = cnt + 1
    plt.tight_layout()
    plt.savefig(
        f"{base_path}/workload{workload}_recordsize.pdf")
    plt.clf()
    plt.close('all')

# x-axis RecordSize, YCSB-A, abort
for workload in ["a"]:
    plt.figure()
    ax = df.plot()
    ax.cla()
    cnt = 0
    for index in df["index"].unique():
        for protocol in df.protocol.unique():
            if protocol == "Silo" and index == "PLI":
                continue
            table = df.query(
                f'workloads=="{workload}" and epoch==1000 and threads=={df.threads.max()} and index=="{index}" and protocol=="{protocol}"')
            line = table.groupby(
                ["index", "protocol", "recordsize"], as_index=False).mean()
            line.plot(x='recordsize', y='abortrate',
                      label=label_gen(protocol, index),
                      ax=ax,
                      style=style(cnt),
                      ylabel="Abort rate (%)",
                      xlabel="# of record size (bytes)")
            cnt = cnt + 1
    plt.tight_layout()
    plt.savefig(
        f"{base_path}/workload{workload}_recordsize_aborts.pdf")
    plt.clf()
    plt.close('all')


# x-axis epoch, YCSB-D, E
for workload in ["d", "e"]:
    for contention in [0.3, 0.99]:
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and threads=={df.threads.max()}  and contention=={contention} and index=="{index}" and protocol=="{protocol}"')
                line = table.groupby(
                    ["index", "protocol", "epoch"], as_index=False).mean()
                line.plot(x='epoch', y='tps',
                            xlim=[0, 1000],
                            label=label_gen(protocol, index),
                            ax=ax,
                            style=style(cnt),
                            ylabel="Thoughput (req/sec)",
                            xlabel="Epoch Duration (ms)")
                cnt = cnt + 1
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_epoch.pdf")
        plt.clf()
        plt.close('all')
