set -e
if [ "$#" -ne "1" ]; then
    echo "ycsb wrapper requires one arguments: number of max threads."
    exit 1
fi
cd $(dirname $0)
cd ../build

mkdir -p artifacts/ycsb/json
mkdir -p artifacts/ycsb/figures

ulimit -c unlimited

echo "workloads,epoch,threads,contention,index,protocol,tps,etime,commits,aborts" >result.csv

# Variable Thread
for workload in a b c wo; do
    for contention in 3 6 9; do
        for number_of_thread in $(seq 1 $1); do
            if [[ $number_of_thread == 1] || [$(expr $number_of_thread % 2) == 1 ]]; then
                continue
            fi

            for protocol in Silo SiloNWR; do
                for index in OpenBwTree PLI; do
                    for times in 1; do
                        bench/ycsb -w $workload -c $protocol -t $number_of_thread -q 4 -i $index -d 1000 -C 0.$contention -o tmp.json 2>>result.csv
                    done
                done
            done
        done
    done
done

# Variable Epoch
for workload in a; do
    for contention in 3 6 9; do
        for number_of_epoch in $(seq 1 200); do
            if [ $(expr $number_of_thread % 10) != 0 ]; then
                continue
            fi

            for protocol in Silo SiloNWR; do
                for index in OpenBwTree PLI; do
                    for times in 1; do
                        bench/ycsb -e $number_of_epoch -w $workload -c $protocol -t $0 -q 4 -i $index -d 1000 -C 0.$contention -o tmp.json 2>>result.csv
                    done
                done
            done
        done
    done
done
