#!/usr/bin/env python3

import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.ticker import ScalarFormatter
import sys
import os

from IPython import embed

df = pd.read_csv(sys.argv[1])
base_path = os.path.dirname(__file__) + "/../build/artifacts/ycsb/figures"

df["abortrate"] = 100 * (df["aborts"] / (df["aborts"] + df["commits"]))
plt.rcParams["font.size"] = 16
plt.rcParams["figure.dpi"] = 150
plt.rcParams["figure.figsize"] = [6, 7]

plt.tight_layout()


def label_gen(p, i):
    if p == "Silo" and i == "OpenBwTree":
        return "Baseline"
    if p == "SiloNWR" and i == "OpenBwTree":
        return "+NWR"
    if p == "SiloNWR" and i == "PLI":
        return "+NWR,PLI"


def style(i):
    return ['+-', 'o-', '.--', 's:'][i]


# x-axis thread (1000ms)
for workload in df.workloads.unique():
    for contention in df.contention.unique():
        if contention not in [0.3, 0.99]:
            continue
        plt.figure()
        ax = df.plot()
        ax.cla()

        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and epoch==1000 and contention=={contention} and index=="{index}" and protocol=="{protocol}"')

                mean = table.groupby(
                    ["index", "protocol", "threads"], as_index=False).mean()
                mean.plot(x='threads', y='tps',
                          xlim=[0, df.threads.max()],
                          label=label_gen(protocol, index),
                          ax=ax,
                          style=style(cnt),
                          ylabel="Thoughput (req/sec)",
                          xlabel="Number of Threads")
                cnt = cnt + 1
        ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
        ax.ticklabel_format(style="sci",  axis="y",scilimits=(0,0))
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_tps.pdf",
            bbox_inches='tight', pad_inches=0.1)
        plt.clf()
        plt.close('all')

# x-axis contention
for workload in df.workloads.unique():
    plt.figure()
    ax = df.plot()
    ax.cla()
    cnt = 0

    for index in df["index"].unique():
        for protocol in df.protocol.unique():
            if protocol == "Silo" and index == "PLI":
                continue
            table = df.query(
                f'workloads=="{workload}" and epoch==1000 and threads=={df.threads.max()} and index=="{index}" and protocol=="{protocol}"')
            line = table.groupby(
                ["index", "protocol", "contention"], as_index=False).mean()
            line.plot(x='contention', y='tps',
                      xlim=[0.0, 1.0],
                      label=label_gen(protocol, index),
                      ax=ax,
                      style=style(cnt),
                      ylabel="Thoughput (req/sec)",
                      xlabel="Contention Rate (theta)")
            cnt = cnt + 1
    ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
    ax.ticklabel_format(style="sci",  axis="y",scilimits=(0,0))
    plt.tight_layout()
    plt.savefig(
        f"{base_path}/workload{workload}_contention.pdf",
        bbox_inches='tight', pad_inches=0.1)
    plt.clf()
    plt.close('all')

# x-axis epoch
for workload in df.workloads.unique():
    for contention in [0.3, 0.99]:
        plt.figure()
        ax = df.plot()
        ax.cla()
        ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
        ax.ticklabel_format(axis="y", style="sci")

        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and threads=={df.threads.max()}  and contention=={contention} and index=="{index}" and protocol=="{protocol}"')
                line = table.groupby(
                    ["index", "protocol", "epoch"], as_index=False).mean()
                line.plot(x='epoch', y='tps',
                            xlim=[0, 1000],
                            label=label_gen(protocol, index),
                            ax=ax,
                            style=style(cnt),
                            ylabel="Thoughput (req/sec)",
                            xlabel="Epoch duration (ms)")
                cnt = cnt + 1
        ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
        ax.ticklabel_format(style="sci",  axis="y",scilimits=(0,0))
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_epoch.pdf",
            bbox_inches='tight', pad_inches=0.1)
        plt.clf()
        plt.close('all')

# x-axis epoch y-axis abort
for workload in df.workloads.unique():
    for contention in [0.3, 0.99]:
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index in df["index"].unique():
            for protocol in df.protocol.unique():
                if protocol == "Silo" and index == "PLI":
                    continue
                table = df.query(
                    f'workloads=="{workload}" and threads=={df.threads.max()}  and contention=={contention} and index=="{index}" and protocol=="{protocol}"')
                line = table.groupby(
                    ["index", "protocol", "epoch"], as_index=False).mean()
                line.plot(x='epoch', y='abortrate',
                            xlim=[0, 1000],
                            ylim=[0, 100],
                            label=label_gen(protocol, index),
                            ax=ax,
                            style=style(cnt),
                            ylabel="Abort rate (%)",
                            xlabel="Epoch duration (ms)")
                cnt = cnt + 1
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_epoch_abort.pdf",
            bbox_inches='tight', pad_inches=0.1)
        plt.clf()
        plt.close('all')
