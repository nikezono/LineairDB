#!/usr/bin/env python3

import pandas as pd
import matplotlib.pyplot as plt
import sys
import os
from matplotlib.ticker import ScalarFormatter


from IPython import embed

df = pd.read_csv(sys.argv[1])
base_path = os.path.dirname(__file__) + "/../build/artifacts/ycsb/figures"

df["abortrate"] = 100 * (df["aborts"] / (df["aborts"] + df["commits"]))

plt.rcParams["font.size"] = 16
plt.rcParams["figure.dpi"] = 150
plt.rcParams["figure.figsize"] = [6, 7]

plt.tight_layout()


def label_gen(p, i):
    if p == "Silo" and i == "OpenBwTree":
        return "Baseline"
    if p == "SiloNWR" and i == "OpenBwTree":
        return "+NWR"
    if p == "Silo" and i == "PLI":
        return "+PLI"
    if p == "SiloNWR" and i == "PLI":
        return "+NWR,PLI"


def style(i):
    return ['+-', 'o-', '.--', 's:'][i]

# x-axis thread (1000ms)
for workload in ["f"]:
    for contention in df.contention.unique():
        if contention not in [0.99]:
            continue
        plt.figure()
        ax = df.plot()
        ax.cla()
        cnt = 0
        for index, protocol in [["OpenBwTree", "Silo"], ["OpenBwTree", "SiloNWR"], ["PLI", "SiloNWR"], ["PLI", "Silo"]]:
            table = df.query(
                f'workloads=="{workload}" and epoch==1000 and contention=={contention} and index=="{index}" and protocol=="{protocol}"')

            if (protocol == "SiloNWR" and index == "PLI"):
                cnt = 2
            if (protocol == "Silo" and index == "PLI"):
                cnt = 3
            sty = style(cnt)
            print(index, protocol,cnt, sty)

            mean = table.groupby(
                ["index", "protocol", "threads"], as_index=False).mean()
            mean.plot(x='threads', y='tps',
                        xlim=[0, df.threads.max()],
                        label=label_gen(protocol, index),
                        ax=ax,
                        style=sty,
                        ylabel="Thoughput (req/sec)",
                        xlabel="Number of Threads")
                        
            cnt = cnt + 1
        ax.yaxis.set_major_formatter(ScalarFormatter(useMathText=True))
        ax.ticklabel_format(style="sci",  axis="y",scilimits=(0,0))
        plt.tight_layout()
        plt.savefig(
            f"{base_path}/workload{workload}_contention{contention}_tps_with_pli.pdf",
                        bbox_inches='tight', pad_inches=0.1)

        plt.clf()
        plt.close('all')
